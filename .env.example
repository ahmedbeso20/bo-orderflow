# ==============================================================================
# OrderFlow Environment Variables (.env.example)
# Copy to .env and fill real values before deploying to production.
# ==============================================================================

# --- Core Server & Deployment ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_URL=
ALLOWED_ORIGINS=
ALLOW_IFRAME=

# Security bypass flags (LOCAL DEVELOPMENT ONLY — never enable in production!)
# ALLOW_INSECURE_DEV=1 bypasses deployed-mode secret checks when testing non-localhost URLs locally.
ALLOW_INSECURE_DEV=
# ALLOW_DEV_DEFAULT_OWNER=1 enables the default local dev owner (owner@orderflow.eg / Owner@2026!) when not deployed.
ALLOW_DEV_DEFAULT_OWNER=

# --- Proxy Trust (Rate Limiting & Origin Verification) ---
# TRUST_PROXY defaults to false (true automatically on Cloud Run when K_SERVICE is set).
# Set TRUST_PROXY=1 ONLY when running behind a trusted reverse proxy (Nginx / Cloudflare / Load Balancer).
TRUST_PROXY=
# TRUST_PROXY_HOPS: number of trusted proxy hops in front of Node.js (default: 1).
TRUST_PROXY_HOPS=1

# --- Database & Storage ---
DATA_DIR=
# DB_FILE takes priority; DB_PATH is supported as a fallback alias (e.g., docker-compose).
DB_FILE=
DB_PATH=
AUTO_SYNC_INTERVAL_MIN=15

# --- Required Production Secrets (>= 32 chars each) ---
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# --- Owner Bootstrap Account (OWNER_PASSWORD must be >= 12 chars and non-weak) ---
OWNER_NAME=
OWNER_EMAIL=
OWNER_PHONE=
OWNER_PASSWORD=

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# --- Privacy, Retention & Security Alerts ---
PII_RETENTION_DAYS=30
AMAZON_PII_ENABLED=0
ALERT_WEBHOOK_URL=
ERROR_WEBHOOK_URL=

# --- Email Provider (Resend, SMTP, or Signed Webhook) ---
RESEND_API_KEY=
MAIL_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_STARTTLS=1
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=

# --- SMS Provider (console | http | twilio) ---
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=OrderFlow
SMS_BODY_TEMPLATE={"to":"{to}","message":"{message}","sender":"{sender}"}
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Payment Gateway (Kashier / Hosted / Sandbox in dev) ---
PAYMENT_PROVIDER=
PAYMENT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WALLET_NUMBER=
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_MODE=test
KASHIER_ALLOWED_METHODS=wallet

# --- Platform Legal & Tax Details (for Receipts) ---
PLATFORM_LEGAL_NAME=
PLATFORM_TAX_ID=

# --- Encrypted Off-Site Backups ---
BACKUP_KEEP_COUNT=7
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto